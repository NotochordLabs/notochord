{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "ops/Dockerfile",
    "watchPatterns": [
      "src/**",
      "runner/**",
      "data/**",
      "protocol/**",
      "ops/Dockerfile",
      "ops/start.sh",
      "package-lock.json",
      "railway.json"
    ]
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ALWAYS"
  }
}
